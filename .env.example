# --- LINE Bot 憑證 ---
# 來源：LINE Developers Console > 你的 Channel > Messaging API 分頁
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# --- Telegram Bot 憑證 ---
# 來源：透過 @BotFather 建立 bot 後取得
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# 驗證 Telegram webhook 請求來源的 secret token
# （呼叫 setWebhook 的 secret_token 參數時須設定相同值）
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_here

# --- Google Gemini（M4 開始使用，多模態辨識） ---
# 來源：Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here
# 主要辨識模型，可選填，不設定時預設 gemini-flash-latest
# GEMINI_MODEL=gemini-flash-latest
# 主要模型回傳 503（服務過載）時自動改用的備用模型，可選填，不設定時預設 gemini-flash-lite-latest
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# --- Google Sheets / Service Account（M2/M5 開始使用） ---
# 本機 service-account JSON 金鑰檔案的路徑
# 建議放置位置：credentials/service-account.json（已列入 .gitignore）
GOOGLE_APPLICATION_CREDENTIALS=credentials/service-account.json
# 管理用 Google Sheet 的 Sheet ID（users & buffer 工作表）
ADMIN_SHEET_ID=your_admin_google_sheet_id_here

# --- PWA 儀表板（M8 開始使用） ---
# GitHub Pages 部署後的公開網址，不含結尾斜線，例如 https://your-account.github.io/PlateScan
WEB_BASE_URL=https://your-account.github.io/your-repo

# --- Gemini 用量控管（M13 開始使用） ---
# 每位使用者每日可觸發的 ok 辨識次數上限，可選填，不設定時預設 30
# DAILY_OK_LIMIT_PER_USER=30
# 單次 ok 最多送進 Gemini 的照片張數，超過時只取前 N 張，可選填，不設定時預設 15
# MAX_PHOTOS_PER_OK=15
